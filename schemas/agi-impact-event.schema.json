{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrimshawlife-ctrl.github.io/Impact-Relay/schemas/agi-impact-event.schema.json",
  "title": "AGI Phase C ImpactEvent fixture document",
  "description": "Public-safe narrative ImpactEvent records matching Autonomous-Giving-Incorporated integration/contracts.ts version 2026-08-02. Fixtures only; not a live cohort.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "events"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "source", "description"],
      "properties": {
        "contractVersion": { "type": "string", "const": "2026-08-02" },
        "source": { "type": "string", "const": "fixture:agi_phase_c" },
        "description": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "allocationId",
          "eventId",
          "type",
          "occurredAt",
          "verificationStatus"
        ],
        "properties": {
          "schemaVersion": { "type": "string", "const": "2026-08-02" },
          "allocationId": {
            "type": "string",
            "pattern": "^alloc_[a-z0-9_]+$",
            "description": "Suite join key. Not a donor id."
          },
          "eventId": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "purchase_approved",
              "receipt_attached",
              "equipment_delivered",
              "program_held",
              "attendance_verified",
              "notification_delivered"
            ]
          },
          "occurredAt": { "type": "string", "minLength": 1 },
          "verificationStatus": {
            "type": "string",
            "enum": ["pending", "verified", "rejected"]
          },
          "evidenceReference": {
            "type": "string",
            "description": "Public-safe pointer only; never a raw receipt, personal data, or secret URL."
          }
        }
      }
    }
  }
}
