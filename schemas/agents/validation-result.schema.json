{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impact-relay.local/schemas/agents/validation-result.schema.json",
  "title": "ValidationResult",
  "description": "Outcome of deterministic validation of an agent proposal. Anything other than ACCEPTED must carry at least one reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ACCEPTED", "REJECTED", "NEEDS_INFORMATION", "BLOCKED"]
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["REJECTED", "NEEDS_INFORMATION", "BLOCKED"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["reasons"]
      }
    }
  ]
}
